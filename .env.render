# MongoDB Atlas connection string
# IMPORTANT: Special characters in password must be URL-encoded
# @ = %40, # = %23, etc.
MONGO_URI=mongodb+srv://your-username:your-password@cluster.mongodb.net/achu_bridal?retryWrites=true&w=majority

# Server
PORT=5000
NODE_ENV=production

# JWT Secret (for admin authentication)
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=7d

# Email Configuration (for booking notifications - optional)
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-gmail-app-password
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
